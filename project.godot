; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Last Game"
config/version="0.8.0"
run/main_scene="res://prototype/menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/max_fps.ios=60
run/max_fps.android=60

[autoload]

Palette="*res://autoload/palette.gd"
Progress="*res://autoload/progress.gd"
Profile="*res://autoload/profile.gd"
Consent="*res://autoload/consent.gd"
Talo="*res://autoload/talo.gd"
BeatClock="*res://prototype/beat_clock.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray()

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
viewport/hdr_2d=true

[shader_globals]

pr_window_back={
"type": "float",
"value": 0.0
}
pr_rim_pulse={
"type": "float",
"value": 0.0
}
pr_seam_pulse={
"type": "float",
"value": 0.0
}
pr_armed_pulse={
"type": "float",
"value": 0.0
}
pr_rim_amber={
"type": "float",
"value": 0.0
}
pr_ripple={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
pr_build_front={
"type": "float",
"value": -1000000000.0
}
pr_light_dir={
"type": "vec3",
"value": Vector3(0.36, 0.8, -0.48)
}
pr_light_on={
"type": "float",
"value": 1.0
}
pr_fog_top={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pr_fog_third={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pr_fog_middle={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pr_fog_bottom={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pr_low_fog_max={
"type": "float",
"value": 0.0
}
