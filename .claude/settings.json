{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-push-gate.sh\"",
            "timeout": 15,
            "statusMessage": "Push gate"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-godot-window.sh\"",
            "timeout": 10,
            "statusMessage": "Godot window guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/gdscript-check.sh\"",
            "timeout": 30,
            "statusMessage": "Parse-checking GDScript"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/layout-version-guard.sh\"",
            "timeout": 10,
            "statusMessage": "LAYOUT_VERSION guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__godot-mcp__play_scene",
      "mcp__godot-mcp__run_test_scenario",
      "mcp__godot-mcp__deploy_to_android"
    ]
  }
}
