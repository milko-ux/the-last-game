{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-push-gate.sh\"",
            "timeout": 15,
            "statusMessage": "Push gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/gdscript-check.sh\"",
            "timeout": 30,
            "statusMessage": "Parse-checking GDScript"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/layout-version-guard.sh\"",
            "timeout": 10,
            "statusMessage": "LAYOUT_VERSION guard"
          }
        ]
      }
    ]
  }
}
